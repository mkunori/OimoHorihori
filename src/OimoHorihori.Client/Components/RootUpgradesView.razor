@using OimoHorihori.Constants
@using OimoHorihori.Models
@using OimoHorihori.Utilities

<section class="ascent-screen">

    <SubpageHeader Title="ROOT強化" OnBack="OnBack" />

    <section class="ascent-status-card">

        <div class="ascent-status-row">
            <span>現在ROOT</span>

            <strong>
                @Game.CurrentRoot
            </strong>
        </div>

        <div class="ascent-status-row">
            <span>ROOT POWER</span>

            <strong>
                @Game.RootPower
                /
                @GameConstants.RootPowerMax
            </strong>
        </div>

    </section>

    <div class="root-section-header">

        <div>
            ROOT POWER
            @Game.RootPower
            /
            @GameConstants.RootPowerMax
        </div>

        <div>
            ROOT @Game.CurrentRoot
        </div>

    </div>

    <div class="root-upgrade-list">

        <button class="upgrade-card" disabled="@(Game.IsRootAbundanceMax || Game.CurrentRoot < 1)"
                @onclick="OnBuyRootAbundance">

            <div class="upgrade-header">

                <span class="upgrade-name">
                    豊穣
                </span>

                <span class="upgrade-level">
                    Lv.@Game.RootAbundanceLevel
                    /
                    @GameConstants.RootAbundanceMaxLevel
                </span>

            </div>

            <div class="upgrade-effect">

                @if (Game.IsRootAbundanceMax)
                {
                    <span>
                        全生産
                        ×@FormatRootMultiplier(Game.RootAbundanceMultiplier)
                    </span>
                }
                else
                {
                    <span>
                        全生産
                        ×@FormatRootMultiplier(Game.RootAbundanceMultiplier)

                        <span class="upgrade-arrow">
                            →
                        </span>

                        ×@FormatRootMultiplier(Game.GetRootAbundanceMultiplier(Game.RootAbundanceLevel + 1))
                    </span>
                }

            </div>

            <div class="upgrade-cost">
                @(Game.IsRootAbundanceMax ? "MAX" : "ROOT 1")
            </div>

        </button>

        <button class="upgrade-card" disabled="@(Game.IsRootFertilityMax || Game.CurrentRoot < 1)"
                @onclick="OnBuyRootFertility">

            <div class="upgrade-header">

                <span class="upgrade-name">
                    肥沃
                </span>

                <span class="upgrade-level">
                    Lv.@Game.RootFertilityLevel
                    /
                    @GameConstants.RootFertilityMaxLevel
                </span>

            </div>

            <div class="upgrade-effect">

                @if (Game.IsRootFertilityMax)
                {
                    <span>
                        畑価格
                        -@FormatRootFertilityReduction(Game.RootFertilityLevel)
                    </span>
                }
                else
                {
                    <span>
                        畑価格
                        -@FormatRootFertilityReduction(Game.RootFertilityLevel)

                        <span class="upgrade-arrow">
                            →
                        </span>

                        -@FormatRootFertilityReduction(Game.RootFertilityLevel + 1)
                    </span>
                }

            </div>

            <div class="upgrade-cost">
                @(Game.IsRootFertilityMax ? "MAX" : "ROOT 1")
            </div>

        </button>

        <button class="upgrade-card" disabled="@(Game.IsRootRetillMax || Game.CurrentRoot < 1)"
                @onclick="OnBuyRootRetill">

            <div class="upgrade-header">

                <span class="upgrade-name">
                    再耕
                </span>

                <span class="upgrade-level">
                    Lv.@Game.RootRetillLevel
                    /
                    @GameConstants.RootRetillMaxLevel
                </span>

            </div>

            <div class="upgrade-effect">

                @if (Game.IsRootRetillMax)
                {
                    <span>
                        RETILL基礎
                        ×@Game.RootAdjustedRetillBase.ToString("0.000")
                    </span>
                }
                else
                {
                    <span>
                        RETILL基礎
                        ×@Game.RootAdjustedRetillBase.ToString("0.000")

                        <span class="upgrade-arrow">
                            →
                        </span>

                        ×@Game.GetRootAdjustedRetillBase(Game.RootRetillLevel + 1) .ToString("0.000")
                    </span>
                }

            </div>

            <div class="upgrade-cost">
                @(Game.IsRootRetillMax ? "MAX" : "ROOT 1")
            </div>

        </button>

        <button class="upgrade-card" disabled="@(Game.IsRootSeedBlessingMax || Game.CurrentRoot < 1)"
                @onclick="OnBuyRootSeedBlessing">

            <div class="upgrade-header">

                <span class="upgrade-name">
                    種の祝福
                </span>

                <span class="upgrade-level">
                    Lv.@Game.RootSeedBlessingLevel
                    /
                    @GameConstants.RootSeedBlessingMaxLevel
                </span>

            </div>

            <div class="upgrade-effect">

                @if (Game.IsRootSeedBlessingMax)
                {
                    <span>
                        種芋獲得
                        ×@FormatRootMultiplier(Game.RootSeedBlessingMultiplier)
                    </span>
                }
                else
                {
                    <span>
                        種芋獲得
                        ×@FormatRootMultiplier(Game.RootSeedBlessingMultiplier)

                        <span class="upgrade-arrow">
                            →
                        </span>

                        ×@FormatRootMultiplier(Game.GetRootSeedBlessingMultiplier(Game.RootSeedBlessingLevel + 1))
                    </span>
                }

            </div>

            <div class="upgrade-cost">
                @(Game.IsRootSeedBlessingMax ? "MAX" : "ROOT 1")
            </div>

        </button>

    </div>

    <section class="auto-root-card">

        <div class="auto-root-header">

            <span>AUTO BUY</span>

            <span>
                @(Game.AutoBuyUnlocked ? "UNLOCKED" : "LOCKED")
            </span>

        </div>

        <div class="auto-root-description">
            購入可能な最上位畑を自動で購入します。
        </div>

        @if (!Game.AutoBuyUnlocked)
        {
            <button disabled="@(Game.CurrentRoot < 1)" @onclick="OnUnlockAutoBuy">
                ROOT 1で解放
            </button>
        }
        else
        {
            <div class="auto-root-unlocked">
                HORIHORI画面で設定できます
            </div>
        }

    </section>

    <section class="auto-root-card">

        <div class="auto-root-header">

            <span>AUTO RETILL</span>

            <span>
                @(Game.AutoRetillUnlocked ? "UNLOCKED" : "LOCKED")
            </span>

        </div>

        <div class="auto-root-description">
            Lv上限へ到達した畑を自動でRETILLします。
        </div>

        @if (!Game.AutoRetillUnlocked)
        {
            <button disabled="@(Game.CurrentRoot < 1)" @onclick="OnUnlockAutoRetill">
                ROOT 1で解放
            </button>
        }
        else
        {
            <div class="auto-root-unlocked">
                HORIHORI画面で設定できます
            </div>
        }

    </section>

</section>

@code {
    [Parameter]
    public required GameState Game { get; set; }

    [Parameter]
    public EventCallback OnBack { get; set; }

    [Parameter]
    public EventCallback OnBuyRootAbundance { get; set; }

    [Parameter]
    public EventCallback OnBuyRootFertility { get; set; }

    [Parameter]
    public EventCallback OnBuyRootRetill { get; set; }

    [Parameter]
    public EventCallback OnBuyRootSeedBlessing { get; set; }

    [Parameter]
    public EventCallback OnUnlockAutoBuy { get; set; }

    [Parameter]
    public EventCallback OnUnlockAutoRetill { get; set; }
    
    private static string FormatRootMultiplier(double multiplier)
    {
        if (!double.IsFinite(multiplier))
        {
            return "-";
        }

        if (multiplier >= 100)
        {
            return multiplier.ToString("0.0");
        }

        if (multiplier >= 10)
        {
            return multiplier.ToString("0.00");
        }

        return multiplier.ToString("0.000");
    }

    private static string FormatRootFertilityReduction(int level)
    {
        double reduction = level * GameConstants.RootFertilityReductionPerLevel * 100.0;

        return $"{reduction:0.0}%";
    }
}