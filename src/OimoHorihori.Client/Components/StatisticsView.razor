@using OimoHorihori.Constants
@using OimoHorihori.Models
@using OimoHorihori.Shared.Saves
@using OimoHorihori.Utilities

<section class="statistics-screen">

    <SubpageHeader Title="統計" OnBack="OnBack" />

    <div class="statistics-list">

        <section class="statistics-section">

            <h3>芋</h3>

            <div class="stat-row">
                <span>累計生産</span>

                <span>
                    @NumberFormatter.Format(Game.TotalPotato)
                    芋
                </span>
            </div>

            <div class="stat-row">
                <span>累計消費</span>

                <span>
                    @NumberFormatter.Format(Game.TotalConsumedPotato)
                    芋
                </span>
            </div>

            <div class="stat-row">
                <span>歴代最高 芋/sec</span>

                <span>
                    @NumberFormatter.Format(Game.BestProductionPerSecond)
                </span>
            </div>

            <div class="stat-row">
                <span>最大周回生産</span>

                <span>
                    @NumberFormatter.Format(Game.MaxRunProducedPotato)
                    芋
                </span>
            </div>

        </section>

        <section class="statistics-section">

            <h3>REPLANT</h3>

            <div class="stat-row">
                <span>REPLANT回数</span>
                <span>@Game.ReplantCount</span>
            </div>

            <div class="stat-row">
                <span>現在の種芋</span>
                <span>@Game.SeedPotato</span>
            </div>

            <div class="stat-row">
                <span>累計獲得種芋</span>
                <span>@Game.TotalSeedPotatoEarned</span>
            </div>

            <div class="stat-row">
                <span>累計消費種芋</span>
                <span>@Game.TotalSeedPotatoSpent</span>
            </div>

            <div class="stat-row">
                <span>最大一括獲得</span>
                <span>@Game.MaxSeedPotatoPerReplant</span>
            </div>

        </section>

        <section class="statistics-section">

            <h3>ASCENT</h3>

            <div class="stat-row">
                <span>ASCENT回数</span>
                <span>@Game.AscentCount</span>
            </div>

            <div class="stat-row">
                <span>現在ROOT</span>
                <span>@Game.CurrentRoot</span>
            </div>

            <div class="stat-row">
                <span>累計獲得ROOT</span>
                <span>@Game.TotalRootEarned</span>
            </div>

            <div class="stat-row">
                <span>使用ROOT</span>
                <span>@Game.UsedRoot</span>
            </div>

            <div class="stat-row">
                <span>ROOT POWER</span>

                <span>
                    @Game.RootPower
                    /
                    @GameConstants.RootPowerMax
                </span>
            </div>

            <div class="stat-row">
                <span>最短ASCENT</span>

                <span>
                    @FormatAscentDuration(Game.BestAscentSeconds)
                </span>
            </div>

            <div class="stat-row">
                <span>現在ASCENT時間</span>

                <span>
                    @FormatAscentDuration(Game.CurrentAscentElapsedSeconds)
                </span>
            </div>

            <div class="stat-row">
                <span>今回のREPLANT</span>
                <span>@Game.CurrentAscentReplantCount</span>
            </div>

        </section>

        <section class="statistics-section">

            <h3>畑</h3>

            @foreach (var farm in FarmStatistics)
            {
                <div class="farm-stat">

                    <div class="farm-stat-name">
                        @farm.Name
                    </div>

                    <div class="stat-row">
                        <span>累計購入</span>

                        <span>
                            @farm.TotalPurchases Lv
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>最高Lv</span>

                        <span>
                            @farm.BestLevel
                        </span>
                    </div>

                </div>
            }

        </section>

        <section class="statistics-section">

            <h3>OFFLINE</h3>

            <div class="stat-row">
                <span>累計オフライン生産</span>

                <span>
                    @NumberFormatter.Format(Game.TotalOfflineProducedPotato)
                    芋
                </span>
            </div>

            <div class="stat-row">
                <span>最大オフライン獲得</span>

                <span>
                    @NumberFormatter.Format(Game.MaxOfflineProducedPotato)
                    芋
                </span>
            </div>

            <div class="stat-row">
                <span>現在の放置上限</span>

                <span>
                    @FormatOfflineUpgradeHours(Game.OfflineUpgradeLevel)
                </span>
            </div>

        </section>

        <section class="statistics-section">

            <h3>PLAY</h3>

            <div class="stat-row">
                <span>プレイ時間</span>

                <span>
                    @FormatPlayTime(Game.TotalPlayTimeSeconds)
                </span>
            </div>

            <div class="stat-row">
                <span>掘る！回数</span>

                <span>
                    @Game.DigButtonCount
                </span>
            </div>

            <div class="stat-row">
                <span>開始日時</span>

                <span>
                    @FormatGameStartedAt()
                </span>
            </div>

        </section>

        <section class="statistics-section">

            <h3>転生履歴</h3>

            <div class="history-tabs">

                <button class="@GetHistoryTabClass(HistoryTab.Replant)"
                        @onclick="() => historyTab = HistoryTab.Replant">
                    REPLANT
                </button>

                <button class="@GetHistoryTabClass(HistoryTab.Ascent)" @onclick="() => historyTab = HistoryTab.Ascent">
                    ASCENT
                </button>

            </div>

            @if (historyTab == HistoryTab.Replant)
            {
                @if (Game.ReplantHistory.Count == 0)
                {
                    <div class="history-empty">
                        REPLANT履歴はまだありません。
                    </div>
                }
                else
                {
                    @for (int i = 0; i < Game.ReplantHistory.Count; i++)
                    {
                        ReplantHistoryEntry entry = Game.ReplantHistory[i];

                        <div class="history-entry">

                            <div class="history-entry-header">
                                <strong>
                                    REPLANT #@(Game.ReplantCount - i)
                                </strong>

                                <span>
                                    @FormatHistoryDate(entry.ReplantedAtUtc)
                                </span>
                            </div>

                            <div class="stat-row">
                                <span>周回時間</span>
                                <span>@FormatReplantDuration(entry.RunDurationSeconds)</span>
                            </div>

                            <div class="stat-row">
                                <span>周回生産</span>
                                <span>
                                    @NumberFormatter.Format(entry.RunProducedPotato) 芋
                                </span>
                            </div>

                            <div class="stat-row">
                                <span>獲得種芋</span>
                                <span>+@entry.EarnedSeedPotato</span>
                            </div>

                        </div>
                    }
                }
            }
            else
            {
                @if (Game.AscentHistory.Count == 0)
                {
                    <div class="history-empty">
                        ASCENT履歴はまだありません。
                    </div>
                }
                else
                {
                    @foreach (AscentHistoryEntry entry in Game.AscentHistory)
                    {
                        <div class="history-entry">

                            <div class="history-entry-header">
                                <strong>
                                    ASCENT #@entry.AscentNumber
                                </strong>

                                <span>
                                    @FormatHistoryDate(entry.AscendedAtUtc)
                                </span>
                            </div>

                            <div class="stat-row">
                                <span>ASCENT時間</span>
                                <span>
                                    @FormatAscentDuration(entry.AscentDurationSeconds)
                                </span>
                            </div>

                            <div class="stat-row">
                                <span>REPLANT</span>
                                <span>@entry.ReplantCount 回</span>
                            </div>

                            <div class="stat-row">
                                <span>最終周回生産</span>
                                <span>
                                    @NumberFormatter.Format(entry.FinalRunProducedPotato) 芋
                                </span>
                            </div>

                        </div>
                    }
                }
            }

        </section>

    </div>

</section>

@code {
    [Parameter]
    public required GameState Game { get; set; }

    [Parameter]
    public EventCallback OnBack { get; set; }

    private HistoryTab historyTab = HistoryTab.Replant;

    private enum HistoryTab
    {
        Replant,
        Ascent
    }

    private IEnumerable<(string Name, int TotalPurchases, int BestLevel)> FarmStatistics =>
    [
        ( "畑1", Game.Farm1TotalPurchases, Game.Farm1BestLevel ),
        ( "畑2", Game.Farm2TotalPurchases, Game.Farm2BestLevel ),
        ( "畑3", Game.Farm3TotalPurchases, Game.Farm3BestLevel ),
        ( "畑4", Game.Farm4TotalPurchases, Game.Farm4BestLevel ),
        ( "畑5", Game.Farm5TotalPurchases, Game.Farm5BestLevel ),
        ( "畑6", Game.Farm6TotalPurchases, Game.Farm6BestLevel ),
        ( "畑7", Game.Farm7TotalPurchases, Game.Farm7BestLevel ),
        ( "畑8", Game.Farm8TotalPurchases, Game.Farm8BestLevel )
    ];

    private static string FormatPlayTime(double totalSeconds)
    {
        if (!double.IsFinite(totalSeconds) || totalSeconds < 0)
        {
            return "00:00:00";
        }

        TimeSpan time = TimeSpan.FromSeconds(totalSeconds);

        int totalHours = (int)time.TotalHours;

        return $"{totalHours:00}:" + $"{time.Minutes:00}:" + $"{time.Seconds:00}";
    }

    private string FormatGameStartedAt()
    {
        if (Game.GameStartedAtUtc == default)
        {
            return "-";
        }

        return Game.GameStartedAtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm");
    }

    private static string FormatOfflineUpgradeHours(int level)
    {
        double seconds = GameConstants.InitialOfflineLimitSeconds + level * GameConstants.OfflineUpgradeSecondsPerLevel;

        seconds = Math.Min(seconds, GameConstants.MaxOfflineLimitSeconds);

        double hours = seconds / 3600.0;

        return $"{hours:0.#}時間";
    }

    private static string FormatAscentDuration(double totalSeconds)
    {
        if (!double.IsFinite(totalSeconds) || totalSeconds <= 0)
        {
            return "--:--:--";
        }

        TimeSpan time = TimeSpan.FromSeconds(totalSeconds);

        int days =
            (int)time.TotalDays;

        if (days > 0)
        {
            return $"{days:00}d " + $"{time.Hours:00}:" + $"{time.Minutes:00}:" + $"{time.Seconds:00}";
        }

        return $"{time.Hours:00}:" + $"{time.Minutes:00}:" + $"{time.Seconds:00}";
    }

    private string GetHistoryTabClass(HistoryTab tab)
    {
        return historyTab == tab ? "history-tab active" : "history-tab";
    }

    private static string FormatHistoryDate(DateTimeOffset date)
    {
        return date.ToLocalTime().ToString("yyyy/MM/dd HH:mm");
    }

    private static string FormatReplantDuration(double totalSeconds)
    {
        if (!double.IsFinite(totalSeconds) || totalSeconds <= 0)
        {
            return "--:--:--";
        }

        TimeSpan time = TimeSpan.FromSeconds(totalSeconds);

        int hours = (int)time.TotalHours;

        return $"{hours:00}:" + $"{time.Minutes:00}:" + $"{time.Seconds:00}";
    }
}