@page "/server-test"

@inject HttpClient Http

<PageTitle>Server Test</PageTitle>

<h1>SERVER TEST</h1>

<button @onclick="CheckServerAsync">
    CHECK
</button>

<p>@message</p>

@code {
    private string message = "未確認";

    private async Task CheckServerAsync()
    {
        try
        {
            string result = await Http.GetStringAsync("api/health");

            message = $"SERVER: {result}";
        }
        catch (Exception ex)
        {
            message = $"ERROR: {ex.Message}";
        }
    }
}