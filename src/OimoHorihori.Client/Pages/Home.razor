        Menu,
        SeedUpgrades,
        Ascent,
        AscentHistory,
        Statistics,
        Achievements,
        OimoBook,
        ReplantHistory,
        Ranking,
        Profile,
        PublicProfile,
        Account,
        Settings
    }

