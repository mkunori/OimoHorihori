@page "/"

@using OimoHorihori.Services

@inject AuthService AuthService
@inject HttpClient Http
@inject IJSRuntime JS
@inject RankingService Rankings
@inject SaveService SaveService
@inject ServerSaveService ServerSave
@inject ProfileService Profiles

@implements IAsyncDisposable

<PageTitle>OIMO HORIHORI</PageTitle>

<main class="game">

    <header class="game-header">

        <h1>OIMO HORIHORI</h1>

    </header>
    @if (currentView == HomeView.Horihori)
    {
        <HorihoriView Game="game" IsInitializing="isInitializing" IsResetting="isResetting"
                      InitializationMessage="@initializationMessage" CurrentSaveStatus="saveStatus"
                      LastSaveCompletedAtUtc="lastSaveCompletedAtUtc" CurrentPurchaseMode="purchaseMode" OnStartGame="StartGame"
                      OnPurchaseModeChanged="SetPurchaseMode" OnBuyFarm="BuyFarm" OnRetillFarm="ExecuteRetillAsync"
                      OnOpenReplant="OpenReplant" OnOpenAscent="OpenAscentConfirmation" OnToggleFarmAutoBuy="ToggleFarmAutoBuyAsync"
                      OnToggleFarmAutoRetill="ToggleFarmAutoRetillAsync" />
    }
    else if (currentView == HomeView.Menu)
    {
        <MenuView Game="game" ShareResultMessage="@shareResultMessage" OnOpenSeedUpgrades="OpenSeedUpgrades"
                  OnOpenRootUpgrades="OpenRootUpgrades" OnOpenOimoBook="OpenOimoBook" OnOpenAchievements="OpenAchievements"
                  OnOpenStatistics="OpenStatistics" OnOpenProfile="OpenProfileAsync" OnOpenRanking="OpenRankingAsync"
                  OnShare="ShareGameAsync" OnOpenSettings="OpenSettings" OnOpenAccount="OpenAccount" />
    }
    else if (currentView == HomeView.SeedUpgrades)
    {
        <SeedUpgradesView Game="game" OnBack="OpenMenu" OnBuyProduction="BuyProductionUpgradeAsync"
                          OnBuyDig="BuyDigUpgradeAsync" OnBuyOffline="BuyOfflineUpgradeAsync"
                          OnBuyRetillEfficiency="BuyRetillEfficiencyUpgradeAsync"
                          OnBuyFieldCostReduction="BuyFieldCostReductionUpgradeAsync" />
    }
    else if (currentView == HomeView.Statistics)
    {
        <StatisticsView Game="game" OnBack="OpenMenu" />
    }
    else if (currentView == HomeView.Achievements)
    {
        <AchievementsView Game="game" OnBack="OpenMenu" />
    }
    else if (currentView == HomeView.OimoBook)
    {
        <OimoBookView Game="game" OnBack="OpenMenu" OnOpenOimoPower="OpenOimoPowerConfirmation" />
    }
    else if (currentView == HomeView.Account)
    {
        <AccountView CurrentUser="currentUser" @bind-LoginUserName="loginUserName" @bind-LoginPin="loginPin"
                     @bind-RegisterUserName="registerUserName" @bind-RegisterPin="registerPin" IsLoggingIn="isLoggingIn"
                     IsRegistering="isRegistering" LoginMessage="@loginMessage" LoginError="@loginError"
                     RegisterMessage="@registerMessage" RegisterError="@registerError" OnBack="OpenMenu" OnLogin="LoginAsync"
                     OnRegister="RegisterAccountAsync" OnLogout="LogoutAsync"
                     OnOpenDeleteConfirmation="OpenDeleteAccountConfirmation" />
    }
    else if (currentView == HomeView.Settings)
    {
        <SettingsView Game="game" OnBack="OpenMenu" OnOpenResetConfirmation="OpenResetConfirmation" />
    }
    else if (currentView == HomeView.Ranking)
    {
        <RankingView CurrentCategory="rankingCategory" Response="rankingResponse" IsLoading="isRankingLoading"
                     Error="@rankingError" OnBack="OpenMenu" OnCategoryChanged="LoadRankingAsync"
                     OnOpenPublicProfile="OpenPublicProfileAsync" />
    }
    else if (currentView == HomeView.Profile)
    {
        <ProfileView Game="game" CurrentUser="currentUser" TitleSettings="titleSettings" IsLoading="isProfileLoading"
                     Error="@profileError" OnBack="OpenMenu" OnEquipTitle="EquipTitleAsync" />
    }
    else if (currentView == HomeView.PublicProfile)
    {
        <PublicProfileView Profile="selectedPublicProfile" IsLoading="isPublicProfileLoading" Error="@publicProfileError"
                           OnBack="BackToRanking" />
    }
    else if (currentView == HomeView.RootUpgrades)
    {
        <RootUpgradesView Game="game" OnBack="OpenMenu" OnBuyRootAbundance="BuyRootAbundanceAsync"
                          OnBuyRootFertility="BuyRootFertilityAsync" OnBuyRootRetill="BuyRootRetillAsync"
                          OnBuyRootSeedBlessing="BuyRootSeedBlessingAsync" OnUnlockAutoBuy="UnlockAutoBuyAsync"
                          OnUnlockAutoRetill="UnlockAutoRetillAsync" />
    }

    <DeleteAccountConfirmationModal IsOpen="showDeleteAccountConfirmation" IsDeleting="isDeletingAccount"
                                    Error="@deleteAccountError" OnCancel="CloseDeleteAccountConfirmation" OnConfirm="DeleteAccountAsync" />


    @if (!isInitializing)
    {
        <nav class="bottom-nav">

            <button class="@GetBottomNavClass(true)" @onclick="OpenHorihori">
                HORIHORI
            </button>

            <button class="@GetBottomNavClass(false)" @onclick="OpenMenu">
                MENU
            </button>

        </nav>
    }
    
</main>

<AchievementNotification Achievement="currentAchievementNotification" OnClose="CloseAchievementNotification" />

<DebugPanel HasStarted="game.HasStarted" OnAddPotato="DebugAddPotatoAsync" OnOffline="DebugOfflineAsync"
            OnAddSeedPotato="DebugAddSeedPotatoAsync" OnAscentReady="DebugAscentReadyAsync"
            OnBuyProductionUpgrade="DebugBuyProductionUpgradeAsync" OnBuyDigUpgrade="DebugBuyDigUpgradeAsync"
            OnBuyOfflineUpgrade="DebugBuyOfflineUpgradeAsync"
            OnBuyRetillEfficiencyUpgrade="DebugBuyRetillEfficiencyUpgradeAsync"
            OnBuyFieldCostReductionUpgrade="DebugBuyFieldCostReductionUpgradeAsync" />

<OfflineResultModal IsOpen="showOfflineResult" Duration="offlineDuration" Reward="offlineReward"
                    OimoDiscoveries="offlineOimoDiscoveries" OnClose="CloseOfflineResult" />

<ResetConfirmationModal IsOpen="showResetConfirmation" IsResetting="isResetting" Error="@resetError"
                        OnCancel="CancelReset" OnConfirm="ResetGameAsync" />

<ReplantModal Game="game" IsOpen="showReplant" IsConfirming="showReplantConfirmation" OnClose="CloseReplant"
              OnOpenConfirmation="OpenReplantConfirmation" OnCancelConfirmation="CancelReplant" OnConfirm="ExecuteReplantAsync" />

<AscentConfirmationModal IsOpen="showAscentConfirmation" OnCancel="CancelAscent" OnConfirm="ExecuteAscentAsync" />

<AscentResultModal IsOpen="showAscentResult" Result="lastAscentResult" OnClose="CloseAscentResult" />

<OimoDiscoveryModal IsOpen="showOimoDiscovery" Species="lastDiscoveredOimo"
                    DiscoveryCount="@GetLastDiscoveredOimoCount()" OnClose="CloseOimoDiscovery" />

<NewerSaveVersionModal NewerVersion="newerSaveVersion" />

<LocalSaveMigrationModal IsOpen="showLocalSaveMigration" OnConfirm="MigrateLocalSaveAsync" />

<SaveConflictModal IsOpen="showSaveConflict" OnLoad="LoadConflictingSaveAsync" />

<OimoPowerConfirmationModal IsOpen="showOimoPowerConfirmation" Species="selectedOimoPowerSpecies"
                            OnCancel="CancelOimoPowerConfirmation" OnConfirm="ConfirmOimoPowerAsync" />