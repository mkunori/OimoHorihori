    private string FormatRankingValue(double value)
    {
        return rankingCategory switch
        {
            RankingCategory.TotalPotato => $"{NumberFormatter.Format(value)} 芋",
            RankingCategory.BestProductionPerSecond => $"{NumberFormatter.Format(value)} 芋 / sec",
            RankingCategory.Replant => $"{(long)value} 回",
            _ => NumberFormatter.Format(value)
        };
    }

