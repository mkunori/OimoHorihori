@page "/"

@using Microsoft.JSInterop
@using OimoHorihori.Constants
@using OimoHorihori.Models
@using OimoHorihori.Services
@using OimoHorihori.Shared.Auth
@using OimoHorihori.Shared.Accounts
@using OimoHorihori.Shared.Rankings
@using OimoHorihori.Shared.Saves
@using OimoHorihori.Shared.Profiles
@using OimoHorihori.Utilities
@using System.Net.Http.Json

@inject AuthService AuthService
@inject HttpClient Http
@inject IJSRuntime JS
@inject RankingService Rankings
@inject SaveService SaveService
@inject ServerSaveService ServerSave
@inject ProfileService Profiles

@implements IAsyncDisposable

<PageTitle>OIMO HORIHORI</PageTitle>

<main class="game">

    <header class="game-header">

        <h1>OIMO HORIHORI</h1>

    </header>
    @if (currentView == HomeView.Horihori)
    {
        if (isInitializing || isResetting)
        {
            <div class="loading-panel">
                <div class="loading-spinner"></div>

                <div>
                    @initializationMessage
                </div>
            </div>
        }
        else if (!game.HasStarted)
        {
            <section class="start-screen">

                <button class="dig-button" @onclick="StartGame">
                    掘る！
                </button>

            </section>
        }
        else
        {
            <section class="status-panel">

                <div class="potato-value">
                    @NumberFormatter.Format(
                        game.Potato)
                    <span class="unit">
                        芋
                    </span>
                </div>

                <div class="production-value">
                    +@NumberFormatter.Format(game.ProductionPerSecond)
                    / sec
                </div>

                <div class="total-value">
                    TOTAL
                    @NumberFormatter.Format(
                        game.TotalPotato)
                </div>

            </section>

            @if (game.AscentCount == 0)
            {
                <section class="next-goal-panel">

                    <span class="next-goal-label">
                        NEXT GOAL
                    </span>

                    <strong>
                        @GetEarlyGameGoalText()
                    </strong>

                </section>
            }

            @if (saveStatus != SaveStatus.None)
            {
                <div class="save-status @GetSaveStatusClass()">

                    <span class="save-status-dot"></span>

                    <span>
                        @GetSaveStatusText()
                    </span>

                    @if (lastSaveCompletedAtUtc is not null)
                    {
                        <span class="save-status-time">
                            @GetLastSaveTimeText()
                        </span>
                    }

                </div>
            }

            <section class="purchase-mode">

                <button class="@GetPurchaseModeClass(PurchaseMode.One)" @onclick="() => SetPurchaseMode(PurchaseMode.One)">
                    +1
                </button>

                <button class="@GetPurchaseModeClass(PurchaseMode.Ten)" @onclick="() => SetPurchaseMode(PurchaseMode.Ten)">
                    +10
                </button>

                <button class="@GetPurchaseModeClass(PurchaseMode.Max)" @onclick="() => SetPurchaseMode(PurchaseMode.Max)">
                    MAX
                </button>

            </section>

            @if (game.CanAscent)
            {
                <button class="ascent-ready-banner" @onclick="OpenAscent">

                    <span>
                        ASCENT READY
                    </span>

                    <span>
                        ROOT +1 ›
                    </span>

                </button>
            }

            @if (RetillReadyCount > 0)
            {
                <div class="retill-ready-summary">

                    <div>
                        RETILL READY
                        <strong>@RetillReadyCount</strong>
                    </div>

                    <a class="retill-ready-jump" href="@($"#{GetFirstRetillReadyFarmId()}")">
                        最初の畑へ
                    </a>

                </div>
            }

            <section class="farm-list">

                @foreach (Farm farm in game.Farms)
                {
                    int purchaseLevels = GetAffordablePurchaseLevels(farm);
                    bool canBuy = purchaseLevels > 0;
                    double purchaseCost = GetPurchaseDisplayCost(farm);

                    <div id="@GetFarmElementId(farm)" class="farm-card @(canBuy || game.CanRetillFarm(farm) ? "" : "unavailable")">

                        <div class="farm-header">
                            <span class="farm-name">
                                @farm.Name
                            </span>

                            <span class="farm-level">
                                Lv.@farm.Level / @farm.MaxLevel
                            </span>
                        </div>

                        <div class="farm-summary">

                            <span class="farm-production">
                                +@NumberFormatter.Format(game.GetFarmProductionPerSecond(farm))
                                / sec
                            </span>

                            <span class="farm-retill-info">
                                @if (farm.IsRetillMax)
                                {
                                    <span>RETILL MAX</span>
                                }
                                else
                                {
                                    <span>
                                        RETILL @farm.RetillCount/@GameConstants.RetillMaxCount
                                    </span>
                                }

                                <span>
                                    ×@game.GetRetillBaseMultiplier(farm).ToString("0.000")
                                </span>
                            </span>

                        </div>

                        @if (farm.CanRetill && !game.IsRetillUnlockedThisRun)
                        {
                            <div class="farm-action-row">

                                <span class="retill-ready">
                                    畑8購入でRETILL解放
                                </span>

                            </div>
                        }
                        else if (game.CanRetillFarm(farm))
                        {
                            <div class="farm-action-row">

                                <span class="retill-ready">
                                    RETILL READY
                                </span>

                                <button class="retill-button" @onclick="() => ExecuteRetillAsync(farm)">
                                    RETILL
                                </button>

                            </div>
                        }
                        else if (farm.IsRetillMax && farm.IsMaxLevel)
                        {
                            <div class="farm-action-row">

                                <span class="farm-complete">
                                    FARM COMPLETE
                                </span>

                            </div>
                        }
                        else
                        {
                            <div class="farm-action-row">

                                <div class="farm-purchase-info">

                                    <span class="farm-purchase-level">
                                        @GetPurchaseLevelText(farm)
                                    </span>

                                    <span class="farm-cost">
                                        COST
                                        @NumberFormatter.Format(purchaseCost)
                                        芋
                                    </span>

                                </div>

                                <button class="farm-buy-button" disabled="@(!canBuy)" @onclick="() => BuyFarm(farm)">
                                    購入
                                </button>

                            </div>
                        }

                    </div>
                }

                <button class="replant-card" @onclick="OpenReplant">

                    <div class="replant-header">

                        <span class="replant-name" disabled="@(!game.CanReplant)">
                            REPLANT
                        </span>

                        <span class="replant-seed">
                            種芋 ×@game.ReplantSeedPotato
                        </span>

                    </div>

                    <div class="replant-production">
                        今回の生産
                        @NumberFormatter.Format(
                            game.RunProducedPotato)
                        芋
                    </div>

                    <div class="replant-next">
                        次の種芋まで
                        @NumberFormatter.Format(
                            game.ProductionUntilNextSeedPotato)
                        芋
                    </div>

                </button>

            </section>

        }

    }
    else if (currentView == HomeView.Menu)
    {
        <section class="menu-screen">

            <h2>MENU</h2>

            <div class="menu-list">

                <button class="menu-item" @onclick="OpenSeedUpgrades">
                    <span>種芋強化</span>
                    <span>›</span>
                </button>

                <button class="menu-item" @onclick="OpenOimoBook">
                    <span>いも図鑑</span>
                    <span>
                        @game.DiscoveredOimoSpeciesCount
                        /20
                    </span>
                </button>

                <button class="menu-item" @onclick="OpenAchievements">
                    <span>実績</span>
                    <span>›</span>
                </button>

                <button class="menu-item" @onclick="OpenStatistics">
                    <span>統計</span>
                    <span>›</span>
                </button>

                <button class="menu-item" @onclick="OpenProfileAsync">
                    <span>プロフィール</span>
                    <span>›</span>
                </button>

                <button class="menu-item" @onclick="OpenRankingAsync">
                    <span>ランキング</span>
                    <span>›</span>
                </button>

                <button class="menu-item" @onclick="OpenReplantHistory">
                    <span>REPLANT履歴</span>
                    <span>›</span>
                </button>

                <button class="menu-item" @onclick="OpenAscent">
                    <span>ASCENT</span>

                    @if (game.CanAscent)
                    {
                        <span>READY</span>
                    }
                    else
                    {
                        <span>
                            ROOT @game.CurrentRoot
                        </span>
                    }
                </button>

                <button class="menu-item" @onclick="ShareGameAsync">
                    <span>共有</span>
                    <span>SHARE</span>
                </button>

                <button class="menu-item" @onclick="OpenSettings">
                    <span>設定</span>
                    <span>›</span>
                </button>

                <button class="menu-item" @onclick="OpenAccount">
                    <span>アカウント</span>
                    <span>›</span>
                </button>

            </div>

            @if (!string.IsNullOrEmpty(shareResultMessage))
            {
                <div class="share-result">
                    @shareResultMessage
                </div>
            }

        </section>

        
    }
    else if (currentView == HomeView.SeedUpgrades)
    {
        <section class="upgrade-screen">

            <div class="subpage-header">

                <button class="back-button" @onclick="OpenMenu">
                    ‹
                </button>

                <h2>種芋強化</h2>

            </div>

            <div class="seed-potato-status">
                <div class="seed-potato-label">
                    種芋
                </div>

                <div class="seed-potato-value">
                    @game.SeedPotato
                </div>
            </div>

            <div class="upgrade-list">

                <button class="upgrade-card" disabled="@(game.SeedPotato < game.ProductionUpgradeCost)"
                        @onclick="BuyProductionUpgradeAsync">

                    <div class="upgrade-header">

                        <span class="upgrade-name">
                            生産力強化
                        </span>

                        <span class="upgrade-level">
                            Lv.@game.ProductionUpgradeLevel
                        </span>

                    </div>

                    <div class="upgrade-effect">
                        全生産
                        +@FormatProductionUpgradeBonus(game.ProductionUpgradeLevel)
                        <span class="upgrade-arrow">→</span>
                        +@FormatProductionUpgradeBonus(game.ProductionUpgradeLevel + 1)
                    </div>

                    <div class="upgrade-cost">
                        NEXT
                        @game.ProductionUpgradeCost
                        種芋
                    </div>

                </button>

                <button class="upgrade-card" disabled="@(game.SeedPotato < game.DigUpgradeCost)"
                        @onclick="BuyDigUpgradeAsync">

                    <div class="upgrade-header">

                        <span class="upgrade-name">
                            掘り出し強化
                        </span>

                        <span class="upgrade-level">
                            Lv.@game.DigUpgradeLevel
                        </span>

                    </div>

                    <div class="upgrade-effect">
                        基礎
                        +@FormatDigUpgradeBonus(game.DigUpgradeLevel)
                        / sec
                        <span class="upgrade-arrow">→</span>
                        +@FormatDigUpgradeBonus(game.DigUpgradeLevel + 1)
                        / sec
                    </div>

                    <div class="upgrade-cost">
                        NEXT
                        @game.DigUpgradeCost
                        種芋
                    </div>

                </button>

                <button class="upgrade-card" disabled="@(!CanBuyOfflineUpgrade())" @onclick="BuyOfflineUpgradeAsync">

                    <div class="upgrade-header">

                        <span class="upgrade-name">
                            放置強化
                        </span>

                        <span class="upgrade-level">
                            Lv.@game.OfflineUpgradeLevel
                        </span>

                    </div>

                    <div class="upgrade-effect">
                        @if (game.IsOfflineUpgradeMax)
                        {
                            <span>
                                最大 @FormatOfflineUpgradeHours()
                            </span>
                        }
                        else
                        {
                            <span>
                                @FormatOfflineUpgradeHours()
                                <span class="upgrade-arrow">→</span>
                                @FormatOfflineUpgradeHours(game.OfflineUpgradeLevel + 1)
                            </span>
                        }
                    </div>

                    <div class="upgrade-cost">

                        @if (game.IsOfflineUpgradeMax)
                        {
                            <span>MAX</span>
                        }
                        else
                        {
                            <span>
                                NEXT
                                @game.OfflineUpgradeCost
                                種芋
                            </span>
                        }

                    </div>

                </button>

                <button class="upgrade-card" disabled="@(game.SeedPotato < game.RetillEfficiencyUpgradeCost)"
                        @onclick="BuyRetillEfficiencyUpgradeAsync">

                    <div class="upgrade-header">

                        <span class="upgrade-name">
                            RETILL効率強化
                        </span>

                        <span class="upgrade-level">
                            Lv.@game.RetillEfficiencyUpgradeLevel
                        </span>

                    </div>

                    <div class="upgrade-effect">
                        RETILL 1回につき
                        +@FormatRetillEfficiencyBonus(game.RetillEfficiencyUpgradeLevel)
                        <span class="upgrade-arrow">→</span>
                        +@FormatRetillEfficiencyBonus(game.RetillEfficiencyUpgradeLevel + 1)
                    </div>

                    <div class="upgrade-cost">
                        NEXT
                        @game.RetillEfficiencyUpgradeCost
                        種芋
                    </div>

                </button>

                <button class="upgrade-card" disabled="@(!CanBuyFieldCostReductionUpgrade())"
                        @onclick="BuyFieldCostReductionUpgradeAsync">

                    <div class="upgrade-header">

                        <span class="upgrade-name">
                            畑コスト軽減
                        </span>

                        <span class="upgrade-level">
                            Lv.@game.FieldCostReductionUpgradeLevel
                        </span>

                    </div>

                    <div class="upgrade-effect">
                        @if (game.IsFieldCostReductionUpgradeMax)
                        {
                            <span>
                                畑価格
                                -@FormatFieldCostReduction(game.FieldCostReductionUpgradeLevel)
                            </span>
                        }
                        else
                        {
                            <span>
                                畑価格
                                -@FormatFieldCostReduction(game.FieldCostReductionUpgradeLevel)
                                <span class="upgrade-arrow">→</span>
                                -@FormatFieldCostReduction(game.FieldCostReductionUpgradeLevel + 1)
                            </span>
                        }
                    </div>

                    <div class="upgrade-cost">

                        @if (game.IsFieldCostReductionUpgradeMax)
                        {
                            <span>MAX</span>
                        }
                        else
                        {
                            <span>
                                NEXT
                                @game.FieldCostReductionUpgradeCost
                                種芋
                            </span>
                        }

                    </div>

                </button>

            </div>

        </section>
    }
    else if (currentView == HomeView.Statistics)
    {
        <section class="statistics-screen">

            <div class="subpage-header">

                <button class="back-button" @onclick="OpenMenu">
                    ‹
                </button>

                <h2>統計</h2>

            </div>

            <div class="statistics-list">

                <section class="statistics-section">

                    <h3>芋</h3>

                    <div class="stat-row">
                        <span>累計生産</span>
                        <span>
                            @NumberFormatter.Format(
                                game.TotalPotato)
                            芋
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>累計消費</span>
                        <span>
                            @NumberFormatter.Format(
                                game.TotalConsumedPotato)
                            芋
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>歴代最高 芋/sec</span>
                        <span>
                            @NumberFormatter.Format(
                                game.BestProductionPerSecond)
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>最大周回生産</span>
                        <span>
                            @NumberFormatter.Format(
                                game.MaxRunProducedPotato)
                            芋
                        </span>
                    </div>

                </section>

                <section class="statistics-section">

                    <h3>REPLANT</h3>

                    <div class="stat-row">
                        <span>REPLANT回数</span>
                        <span>
                            @game.ReplantCount
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>現在の種芋</span>
                        <span>
                            @game.SeedPotato
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>累計獲得種芋</span>
                        <span>
                            @game.TotalSeedPotatoEarned
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>累計消費種芋</span>
                        <span>
                            @game.TotalSeedPotatoSpent
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>最大一括獲得</span>
                        <span>
                            @game.MaxSeedPotatoPerReplant
                        </span>
                    </div>

                </section>

                <section class="statistics-section">

                    <h3>ASCENT</h3>

                    <div class="stat-row">
                        <span>ASCENT回数</span>
                        <span>
                            @game.AscentCount
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>現在ROOT</span>
                        <span>
                            @game.CurrentRoot
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>累計獲得ROOT</span>
                        <span>
                            @game.TotalRootEarned
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>使用ROOT</span>
                        <span>
                            @game.UsedRoot
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>ROOT POWER</span>
                        <span>
                            @game.RootPower
                            /
                            @GameConstants.RootPowerMax
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>最短ASCENT</span>
                        <span>
                            @FormatAscentDuration(game.BestAscentSeconds)
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>現在ASCENT時間</span>
                        <span>
                            @FormatAscentDuration(game.CurrentAscentElapsedSeconds)
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>今回のREPLANT</span>
                        <span>
                            @game.CurrentAscentReplantCount
                        </span>
                    </div>

                </section>
                <section class="statistics-section">

                    <h3>畑</h3>

                    <div class="farm-stat">

                        <div class="farm-stat-name">
                            畑1
                        </div>

                        <div class="stat-row">
                            <span>累計購入</span>
                            <span>
                                @game.Farm1TotalPurchases Lv
                            </span>
                        </div>

                        <div class="stat-row">
                            <span>最高Lv</span>
                            <span>
                                @game.Farm1BestLevel
                            </span>
                        </div>

                    </div>

                    <div class="farm-stat">

                        <div class="farm-stat-name">
                            畑2
                        </div>

                        <div class="stat-row">
                            <span>累計購入</span>
                            <span>
                                @game.Farm2TotalPurchases Lv
                            </span>
                        </div>

                        <div class="stat-row">
                            <span>最高Lv</span>
                            <span>
                                @game.Farm2BestLevel
                            </span>
                        </div>

                    </div>

                    <div class="farm-stat">

                        <div class="farm-stat-name">
                            畑3
                        </div>

                        <div class="stat-row">
                            <span>累計購入</span>
                            <span>
                                @game.Farm3TotalPurchases Lv
                            </span>
                        </div>

                        <div class="stat-row">
                            <span>最高Lv</span>
                            <span>
                                @game.Farm3BestLevel
                            </span>
                        </div>

                    </div>

                    <div class="farm-stat">

                        <div class="farm-stat-name">
                            畑4
                        </div>

                        <div class="stat-row">
                            <span>累計購入</span>
                            <span>
                                @game.Farm4TotalPurchases Lv
                            </span>
                        </div>

                        <div class="stat-row">
                            <span>最高Lv</span>
                            <span>
                                @game.Farm4BestLevel
                            </span>
                        </div>

                    </div>

                    <div class="farm-stat">

                        <div class="farm-stat-name">
                            畑5
                        </div>

                        <div class="stat-row">
                            <span>累計購入</span>
                            <span>
                                @game.Farm5TotalPurchases Lv
                            </span>
                        </div>

                        <div class="stat-row">
                            <span>最高Lv</span>
                            <span>
                                @game.Farm5BestLevel
                            </span>
                        </div>

                    </div>

                    <div class="farm-stat">

                        <div class="farm-stat-name">
                            畑6
                        </div>

                        <div class="stat-row">
                            <span>累計購入</span>
                            <span>
                                @game.Farm6TotalPurchases Lv
                            </span>
                        </div>

                        <div class="stat-row">
                            <span>最高Lv</span>
                            <span>
                                @game.Farm6BestLevel
                            </span>
                        </div>

                    </div>

                    <div class="farm-stat">

                        <div class="farm-stat-name">
                            畑7
                        </div>

                        <div class="stat-row">
                            <span>累計購入</span>
                            <span>
                                @game.Farm7TotalPurchases Lv
                            </span>
                        </div>

                        <div class="stat-row">
                            <span>最高Lv</span>
                            <span>
                                @game.Farm7BestLevel
                            </span>
                        </div>

                    </div>

                    <div class="farm-stat">

                        <div class="farm-stat-name">
                            畑8
                        </div>

                        <div class="stat-row">
                            <span>累計購入</span>
                            <span>
                                @game.Farm8TotalPurchases Lv
                            </span>
                        </div>

                        <div class="stat-row">
                            <span>最高Lv</span>
                            <span>
                                @game.Farm8BestLevel
                            </span>
                        </div>

                    </div>

                </section>

                <section class="statistics-section">

                    <h3>OFFLINE</h3>

                    <div class="stat-row">
                        <span>累計オフライン生産</span>
                        <span>
                            @NumberFormatter.Format(
                                game.TotalOfflineProducedPotato)
                            芋
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>最大オフライン獲得</span>
                        <span>
                            @NumberFormatter.Format(
                                game.MaxOfflineProducedPotato)
                            芋
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>現在の放置上限</span>
                        <span>
                            @FormatOfflineUpgradeHours()
                        </span>
                    </div>

                </section>

                <section class="statistics-section">

                    <h3>PLAY</h3>

                    <div class="stat-row">
                        <span>プレイ時間</span>
                        <span>
                            @FormatPlayTime(
                                game.TotalPlayTimeSeconds)
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>掘る！回数</span>
                        <span>
                            @game.DigButtonCount
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>開始日時</span>
                        <span>
                            @FormatGameStartedAt()
                        </span>
                    </div>

                </section>

            </div>

        </section>
    }
    else if (currentView == HomeView.Achievements)
    {
        <section class="achievements-screen">

            <div class="subpage-header">

                <button class="back-button" @onclick="OpenMenu">
                    ‹
                </button>

                <h2>実績</h2>

            </div>

            <div class="achievement-progress">

                @GetUnlockedAchievementCount()
                /
                @AchievementCatalog.All.Count

            </div>

            <div class="achievement-list">

                @foreach (
                    AchievementDefinition achievement
                    in AchievementCatalog.All)
                {
                    bool unlocked =
                        game.IsAchievementUnlocked(
                            achievement.Id);

                    <div class="@GetAchievementClass(unlocked)">

                        <div class="achievement-header">

                            <span class="achievement-name">
                                @achievement.Name
                            </span>

                            @if (unlocked)
                            {
                                <span class="achievement-status">
                                    CLEAR
                                </span>
