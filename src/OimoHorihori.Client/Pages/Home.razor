    private void OpenHorihori()
    {
        shareResultMessage = null;
        currentView = HomeView.Horihori;
    }

    private void OpenMenu()
    {
        currentView = HomeView.Menu;
    }

    private void OpenSeedUpgrades()
    {
        currentView = HomeView.SeedUpgrades;
    }

    private async Task BuyProductionUpgradeAsync()
    {
        if (game.BuyProductionUpgrade())
        {
            CheckAchievements();

            await SaveGameAsync();
        }
    }

    private async Task BuyDigUpgradeAsync()
    {
        if (game.BuyDigUpgrade())
        {
            CheckAchievements();

            await SaveGameAsync();
        }
    }

    private async Task BuyOfflineUpgradeAsync()
    {
        if (game.BuyOfflineUpgrade())
        {
            CheckAchievements();

            await SaveGameAsync();
        }
    }

    private string GetBottomNavClass(
    bool horihori)
    {
        bool selected = horihori ? currentView == HomeView.Horihori : currentView != HomeView.Horihori;

        return selected ? "bottom-nav-button selected" : "bottom-nav-button";
    }

    private void OpenStatistics()
    {
        currentView = HomeView.Statistics;
    }

    private void OpenAchievements()
    {
        currentView = HomeView.Achievements;
    }

    private void CloseOimoDiscovery()
    {
        showOimoDiscovery = false;
    }

    private void OpenOimoBook()
    {
        currentView =
            HomeView.OimoBook;
    }

    private string BuildShareText()
    {
        return
            "🍠 OIMO HORIHORI\n"
            + $"累計 {NumberFormatter.Format(game.TotalPotato)}芋"
            + $" / REPLANT {game.ReplantCount}回"
            + $" / 種芋 {game.SeedPotato}"
