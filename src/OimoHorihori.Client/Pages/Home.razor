    private string GetEarlyGameGoalText()
    {
        Farm farm8 = game.Farms[7];

        if (farm8.PurchaseCount == 0)
        {
            return "畑8を購入する";
        }

        if (game.CurrentAscentReplantCount == 0)
        {
            if (game.CanReplant)
            {
                return "REPLANTして種芋を獲得する";
            }

            return
                $"種芋まであと " + $"{NumberFormatter.Format(game.ProductionUntilNextSeedPotato)} 芋";
        }

        if (game.CanAscent)
        {
            return "ASCENTする";
        }

        double remaining = Math.Max(0, GameConstants.AscentTargetProduction - game.RunProducedPotato);

        return
            $"ASCENTまであと " + $"{NumberFormatter.Format(remaining)} 芋";
    }
