@page "/"

@using Microsoft.JSInterop
@using OimoHorihori.Constants
@using OimoHorihori.Models
@using OimoHorihori.Services
@using OimoHorihori.Shared.Auth
@using OimoHorihori.Shared.Accounts
@using OimoHorihori.Shared.Rankings
@using OimoHorihori.Shared.Saves
@using OimoHorihori.Shared.Profiles
@using OimoHorihori.Utilities
@using System.Net.Http.Json

@inject AuthService AuthService
@inject HttpClient Http
@inject IJSRuntime JS
@inject RankingService Rankings
@inject SaveService SaveService
@inject ServerSaveService ServerSave
@inject ProfileService Profiles

@implements IAsyncDisposable

<PageTitle>OIMO HORIHORI</PageTitle>

<main class="game">

    <header class="game-header">

        <h1>OIMO HORIHORI</h1>

    </header>
    @if (currentView == HomeView.Horihori)
    {
        @if (isInitializing)
        {
            <div class="loading-panel">
                <div>セーブデータを読み込み中...</div>
            </div>
        }
        else if (!game.HasStarted)
        {
            <section class="start-screen">

                <button class="dig-button" @onclick="StartGame">
                    掘る！
                </button>

            </section>
        }
        else
        {
            <section class="status-panel">

                <div class="potato-value">
                    @NumberFormatter.Format(
                        game.Potato)
                    <span class="unit">
                        芋
                    </span>
                </div>

                <div class="production-value">
                    +@NumberFormatter.Format(game.ProductionPerSecond)
                    / sec
                </div>

                <div class="total-value">
                    TOTAL
                    @NumberFormatter.Format(
                        game.TotalPotato)
                </div>

            </section>

            <section class="purchase-mode">

                <button class="@GetPurchaseModeClass(PurchaseMode.One)" @onclick="() => SetPurchaseMode(PurchaseMode.One)">
                    +1
                </button>

                <button class="@GetPurchaseModeClass(PurchaseMode.Ten)" @onclick="() => SetPurchaseMode(PurchaseMode.Ten)">
                    +10
                </button>

                <button class="@GetPurchaseModeClass(PurchaseMode.Max)" @onclick="() => SetPurchaseMode(PurchaseMode.Max)">
                    MAX
                </button>

            </section>

            <section class="farm-list">

                @foreach (Farm farm in game.Farms)
                {
                    int purchaseLevels = GetAffordablePurchaseLevels(farm);
                    bool canBuy = purchaseLevels > 0;
                    double purchaseCost = GetPurchaseDisplayCost(farm);

                    <div class="farm-card @(canBuy || farm.CanRetill ? "" : "unavailable")">

                        <div class="farm-header">

                            <span class="farm-name">
                                @farm.Name
                            </span>

                            <span class="farm-level">
                                Lv. @farm.Level / @farm.MaxLevel
                            </span>

                        </div>

                        <div class="farm-retill-info">
                            @if (farm.IsRetillMax)
                            {
                                <span>
                                    RETILL MAX
                                </span>
                            }
                            else
                            {
                                <span>
                                    RETILL @farm.RetillCount / @GameConstants.RetillMaxCount
                                </span>
                            }

                            <span>
                                ×@farm.RetillMultiplier.ToString("0.000")
                            </span>
                        </div>

                        <div class="farm-production">
                            +@NumberFormatter.Format(game.GetFarmProductionPerSecond(farm))
                            / sec
                        </div>

                        @if (farm.CanRetill)
                        {
                            <div class="retill-ready">
                                RETILL READY
                            </div>

                            <button class="retill-button" @onclick="() => OpenRetillConfirmation(farm)">
                                RETILL
                            </button>
                        }
                        else if (farm.IsRetillMax && farm.IsMaxLevel)
                        {
                            <div class="farm-complete">
                                MAX
                            </div>
                        }
                        else
                        {
                            <div class="farm-purchase-level">
                                @GetPurchaseLevelText(farm)
                            </div>

                            <div class="farm-cost">
                                COST
                                @NumberFormatter.Format(purchaseCost)
                                芋
                            </div>

                            <button class="farm-buy-button" disabled="@(!canBuy)" @onclick="() => BuyFarm(farm)">
                                購入
                            </button>
                        }

                    </div>
                }

                <button class="replant-card" @onclick="OpenReplant">

                    <div class="replant-header">

                        <span class="replant-name" disabled="@(!game.CanReplant)">
                            REPLANT
                        </span>

                        <span class="replant-seed">
                            種芋 ×@game.ReplantSeedPotato
                        </span>

                    </div>

                    <div class="replant-production">
                        今回の生産
                        @NumberFormatter.Format(
                            game.RunProducedPotato)
                        芋
                    </div>

                    <div class="replant-next">
                        次の種芋まで
                        @NumberFormatter.Format(
                            game.ProductionUntilNextSeedPotato)
                        芋
                    </div>

                </button>

            </section>

        }

    }
    else if (currentView == HomeView.Menu)
    {
        <section class="menu-screen">

            <h2>MENU</h2>

            <div class="menu-list">

                <button class="menu-item" @onclick="OpenSeedUpgrades">
                    <span>種芋強化</span>
                    <span>›</span>
                </button>

                <button class="menu-item" @onclick="OpenOimoBook">
                    <span>いも図鑑</span>
                    <span>
                        @game.DiscoveredOimoSpeciesCount
                        /20
                    </span>
                </button>

                <button class="menu-item" @onclick="OpenAchievements">
                    <span>実績</span>
                    <span>›</span>
                </button>

                <button class="menu-item" @onclick="OpenStatistics">
                    <span>統計</span>
                    <span>›</span>
                </button>

                <button class="menu-item" @onclick="OpenProfileAsync">
                    <span>プロフィール</span>
                    <span>›</span>
                </button>

                <button class="menu-item" @onclick="OpenRankingAsync">
                    <span>ランキング</span>
                    <span>›</span>
                </button>

                <button class="menu-item" @onclick="OpenReplantHistory">
                    <span>REPLANT履歴</span>
                    <span>›</span>
                </button>

                <button class="menu-item" @onclick="ShareGameAsync">
                    <span>共有</span>
                    <span>SHARE</span>
                </button>

                <button class="menu-item" @onclick="OpenSettings">
                    <span>設定</span>
                    <span>›</span>
                </button>

                <button class="menu-item" @onclick="OpenAccount">
                    <span>アカウント</span>
                    <span>›</span>
                </button>

            </div>

            @if (!string.IsNullOrEmpty(shareResultMessage))
            {
                <div class="share-result">
                    @shareResultMessage
                </div>
            }

        </section>

        
    }
    else if (currentView == HomeView.SeedUpgrades)
    {
        <section class="upgrade-screen">

            <div class="subpage-header">

                <button class="back-button" @onclick="OpenMenu">
                    ‹
                </button>

                <h2>種芋強化</h2>

            </div>

            <div class="seed-potato-status">
                <div class="seed-potato-label">
                    種芋
                </div>

                <div class="seed-potato-value">
                    @game.SeedPotato
                </div>
            </div>

            <div class="upgrade-list">

                <button class="upgrade-card" disabled="@(game.SeedPotato < game.ProductionUpgradeCost)"
                        @onclick="BuyProductionUpgradeAsync">

                    <div class="upgrade-header">

                        <span class="upgrade-name">
                            生産力強化
                        </span>

                        <span class="upgrade-level">
                            Lv.@game.ProductionUpgradeLevel
                        </span>

                    </div>

                    <div class="upgrade-effect">
                        全生産
                        +@((game.ProductionUpgradeLevel * 2.0).ToString("0"))%
                    </div>

                    <div class="upgrade-cost">
                        NEXT
                        @game.ProductionUpgradeCost
                        種芋
                    </div>

                </button>

                <button class="upgrade-card" disabled="@(game.SeedPotato < game.DigUpgradeCost)"
                        @onclick="BuyDigUpgradeAsync">

                    <div class="upgrade-header">

                        <span class="upgrade-name">
                            掘り出し強化
                        </span>

                        <span class="upgrade-level">
                            Lv.@game.DigUpgradeLevel
                        </span>

                    </div>

                    <div class="upgrade-effect">
                        基礎
                        +@((game.DigUpgradeLevel * 0.5).ToString("0.0"))
                        / sec
                    </div>

                    <div class="upgrade-cost">
                        NEXT
                        @game.DigUpgradeCost
                        種芋
                    </div>

                </button>

                <button class="upgrade-card" disabled="@(!CanBuyOfflineUpgrade())" @onclick="BuyOfflineUpgradeAsync">

                    <div class="upgrade-header">

                        <span class="upgrade-name">
                            放置強化
                        </span>

                        <span class="upgrade-level">
                            Lv.@game.OfflineUpgradeLevel
                        </span>

                    </div>

                    <div class="upgrade-effect">
                        最大
                        @FormatOfflineUpgradeHours()
                    </div>

                    <div class="upgrade-cost">

                        @if (game.IsOfflineUpgradeMax)
                        {
                            <span>MAX</span>
                        }
                        else
                        {
                            <span>
                                NEXT
                                @game.OfflineUpgradeCost
                                種芋
                            </span>
                        }

                    </div>

                </button>

                <button class="upgrade-card" disabled="@(game.SeedPotato < game.FieldEfficiencyUpgradeCost)"
                        @onclick="BuyFieldEfficiencyUpgradeAsync">

                    <div class="upgrade-header">

                        <span class="upgrade-name">
                            畑効率強化
                        </span>

                        <span class="upgrade-level">
                            Lv.@game.FieldEfficiencyUpgradeLevel
                        </span>

                    </div>

                    <div class="upgrade-effect">
                        全畑生産
                        +@((game.FieldEfficiencyUpgradeLevel * 2.0).ToString("0"))%
                    </div>

                    <div class="upgrade-cost">
                        NEXT
                        @game.FieldEfficiencyUpgradeCost
                        種芋
                    </div>

                </button>

                <button class="upgrade-card" disabled="@(!CanBuyFieldCostReductionUpgrade())"
                        @onclick="BuyFieldCostReductionUpgradeAsync">

                    <div class="upgrade-header">

                        <span class="upgrade-name">
                            畑コスト軽減
                        </span>

                        <span class="upgrade-level">
                            Lv.@game.FieldCostReductionUpgradeLevel
                        </span>

                    </div>

                    <div class="upgrade-effect">
                        畑価格
                        -@((game.FieldCostReductionUpgradeLevel * 0.25).ToString("0.00"))%
                    </div>

                    <div class="upgrade-cost">

                        @if (game.IsFieldCostReductionUpgradeMax)
                        {
                            <span>MAX</span>
                        }
                        else
                        {
                            <span>
                                NEXT
                                @game.FieldCostReductionUpgradeCost
                                種芋
                            </span>
                        }

                    </div>

                </button>

            </div>

        </section>
    }
    else if (currentView == HomeView.Statistics)
    {
        <section class="statistics-screen">

            <div class="subpage-header">

                <button class="back-button" @onclick="OpenMenu">
                    ‹
                </button>

                <h2>統計</h2>

            </div>

            <div class="statistics-list">

                <section class="statistics-section">

                    <h3>芋</h3>

                    <div class="stat-row">
                        <span>累計生産</span>
                        <span>
                            @NumberFormatter.Format(
                                game.TotalPotato)
                            芋
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>累計消費</span>
                        <span>
                            @NumberFormatter.Format(
                                game.TotalConsumedPotato)
                            芋
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>歴代最高 芋/sec</span>
                        <span>
                            @NumberFormatter.Format(
                                game.BestProductionPerSecond)
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>最大周回生産</span>
                        <span>
                            @NumberFormatter.Format(
                                game.MaxRunProducedPotato)
                            芋
                        </span>
                    </div>

                </section>

                <section class="statistics-section">

                    <h3>REPLANT</h3>

                    <div class="stat-row">
                        <span>REPLANT回数</span>
                        <span>
                            @game.ReplantCount
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>現在の種芋</span>
                        <span>
                            @game.SeedPotato
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>累計獲得種芋</span>
                        <span>
                            @game.TotalSeedPotatoEarned
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>累計消費種芋</span>
                        <span>
                            @game.TotalSeedPotatoSpent
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>最大一括獲得</span>
                        <span>
                            @game.MaxSeedPotatoPerReplant
                        </span>
                    </div>

                </section>

                <section class="statistics-section">

                    <h3>畑</h3>

                    <div class="farm-stat">

                        <div class="farm-stat-name">
                            畑1
                        </div>

                        <div class="stat-row">
                            <span>累計購入</span>
                            <span>
                                @game.Farm1TotalPurchases Lv
                            </span>
                        </div>

                        <div class="stat-row">
                            <span>最高Lv</span>
                            <span>
                                @game.Farm1BestLevel
                            </span>
                        </div>

                    </div>

                    <div class="farm-stat">

                        <div class="farm-stat-name">
                            畑2
                        </div>

                        <div class="stat-row">
                            <span>累計購入</span>
                            <span>
                                @game.Farm2TotalPurchases Lv
                            </span>
                        </div>

                        <div class="stat-row">
                            <span>最高Lv</span>
                            <span>
                                @game.Farm2BestLevel
                            </span>
                        </div>

                    </div>

                    <div class="farm-stat">

                        <div class="farm-stat-name">
                            畑3
                        </div>

                        <div class="stat-row">
                            <span>累計購入</span>
                            <span>
                                @game.Farm3TotalPurchases Lv
                            </span>
                        </div>

                        <div class="stat-row">
                            <span>最高Lv</span>
                            <span>
                                @game.Farm3BestLevel
                            </span>
                        </div>

                    </div>

                </section>

                <section class="statistics-section">

                    <h3>OFFLINE</h3>

                    <div class="stat-row">
                        <span>累計オフライン生産</span>
                        <span>
                            @NumberFormatter.Format(
                                game.TotalOfflineProducedPotato)
                            芋
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>最大オフライン獲得</span>
                        <span>
                            @NumberFormatter.Format(
                                game.MaxOfflineProducedPotato)
                            芋
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>現在の放置上限</span>
                        <span>
                            @FormatOfflineUpgradeHours()
                        </span>
                    </div>

                </section>

                <section class="statistics-section">

                    <h3>PLAY</h3>

                    <div class="stat-row">
                        <span>プレイ時間</span>
                        <span>
                            @FormatPlayTime(
                                game.TotalPlayTimeSeconds)
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>掘る！回数</span>
                        <span>
                            @game.DigButtonCount
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>開始日時</span>
                        <span>
                            @FormatGameStartedAt()
                        </span>
                    </div>

                </section>

            </div>

        </section>
    }
    else if (currentView == HomeView.Achievements)
    {
        <section class="achievements-screen">

            <div class="subpage-header">

                <button class="back-button" @onclick="OpenMenu">
                    ‹
                </button>

                <h2>実績</h2>

            </div>

            <div class="achievement-progress">

                @GetUnlockedAchievementCount()
                /
                @AchievementCatalog.All.Count

            </div>

            <div class="achievement-list">

                @foreach (
                    AchievementDefinition achievement
                    in AchievementCatalog.All)
                {
                    bool unlocked =
                        game.IsAchievementUnlocked(
                            achievement.Id);

                    <div class="@GetAchievementClass(unlocked)">

                        <div class="achievement-header">

                            <span class="achievement-name">
                                @achievement.Name
                            </span>

                            @if (unlocked)
                            {
                                <span class="achievement-status">
                                    CLEAR
                                </span>
                            }

                        </div>

                        <div class="achievement-description">
                            @achievement.Description
                        </div>

                        @if (unlocked)
                        {
                            <div class="achievement-date">
                                @FormatAchievementDate(
                                    achievement.Id)
                            </div>
                        }

                    </div>
                }

            </div>

        </section>
    }
    else if (currentView == HomeView.OimoBook)
    {
        <section class="oimo-book-screen">

            <div class="subpage-header">

                <button class="back-button" @onclick="OpenMenu">
                    ‹
                </button>

                <h2>いも図鑑</h2>

            </div>

            <div class="oimo-book-progress">

                @game.DiscoveredOimoSpeciesCount
                / 20

            </div>

            <div class="oimo-book-list">

                @foreach (
                    OimoSpeciesDefinition species
                    in OimoSpeciesCatalog.All)
                {
                    bool discovered =
                        game.IsOimoDiscovered(
                            species.Id);

                    <div class="@GetOimoBookCardClass(discovered)">

                        <div class="oimo-book-number">
                            #@GetOimoSpeciesNumber(species)
                        </div>

                        <div class="oimo-book-name">

                            @if (discovered)
                            {
                                @species.Name
                            }
                            else
                            {
                                <span>??????</span>
                            }

                        </div>

                        @if (discovered)
                        {
                            <div class="oimo-book-count">
                                ×@game.GetOimoDiscoveryCount(species.Id)
                            </div>
                        }

                    </div>
                }

            </div>

        </section>
    }
    else if (currentView == HomeView.Account)
    {
        <section class="account-screen">

            <div class="subpage-header">

                <button class="back-button" @onclick="OpenMenu">
                    ‹
                </button>

                <h2>ACCOUNT</h2>

            </div>

            @if (currentUser is not null)
            {
                <section class="account-card">

                    <h3>ログイン中</h3>

                    <div>
                        USERNAME
                    </div>

                    <div>
                        @currentUser.UserName
                    </div>

                    <button @onclick="LogoutAsync">
                        ログアウト
                    </button>

                    <button class="account-delete-button" @onclick="OpenDeleteAccountConfirmation">
                        アカウント削除
                    </button>

                </section>
            }
            else
            {
                <section class="account-card">

                    <h3>ログイン</h3>

                    <div class="account-field">
                        <label>USERNAME</label>

                        <input type="text" maxlength="10" autocomplete="username" @bind="loginUserName" />
                    </div>

                    <div class="account-field">
                        <label>4-DIGIT PIN</label>

                        <input type="password" maxlength="4" inputmode="numeric" autocomplete="current-password"
                               @bind="loginPin" />
                    </div>

                    <button class="account-register-button" disabled="@isLoggingIn" @onclick="LoginAsync">

                        @(isLoggingIn
                            ? "ログイン中..."
                            : "ログイン")

                    </button>

                    @if (!string.IsNullOrEmpty(loginError))
                    {
                        <div class="account-message error">
                            @loginError
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(loginMessage))
                    {
                        <div class="account-message success">
                            @loginMessage
                        </div>
                    }

                </section>

                <section class="account-card">

                    <h3>ユーザー登録</h3>

                    <div class="account-field">
                        <label>USERNAME</label>

                        <input type="text" maxlength="10" autocomplete="username" @bind="registerUserName" />

                        <div class="account-hint">
                            1〜10文字
                        </div>
                    </div>

                    <div class="account-field">
                        <label>4-DIGIT PIN</label>

                        <input type="password" maxlength="4" inputmode="numeric" autocomplete="new-password"
                               @bind="registerPin" />

                        <div class="account-hint">
                            数字4桁
                        </div>
                    </div>

                    <button class="account-register-button" disabled="@isRegistering" @onclick="RegisterAccountAsync">

                        @(isRegistering
                            ? "登録中..."
                            : "登録する")

                    </button>

                    @if (!string.IsNullOrEmpty(registerError))
                    {
                        <div class="account-message error">
                            @registerError
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(registerMessage))
                    {
                        <div class="account-message success">
                            @registerMessage
                        </div>
                    }

                </section>
            }


        </section>
    }
    else if (currentView == HomeView.Settings)
    {
        <section class="settings-screen">

            <div class="subpage-header">

                <button class="back-button" @onclick="OpenMenu">
                    ‹
                </button>

                <h2>設定</h2>

            </div>

            <div class="settings-list">

                <section class="settings-card">

                    <div class="settings-row">

                        <span>
                            OFFLINE LIMIT
                        </span>

                        <span>
                            @FormatOfflineLimit()
                        </span>

                    </div>

                </section>

                <section class="settings-card">

                    <div class="settings-row">

                        <span>
                            VERSION
                        </span>

                        <span>
                            @BuildInfo.Version
                        </span>

                    </div>

                </section>

                <section class="settings-card">

                    <div class="settings-card-title">
                        DATA
                    </div>

                    <button class="reset-button" @onclick="OpenResetConfirmation">
                        セーブデータ初期化
                    </button>

                </section>

            </div>

        </section>
    }
    else if (currentView == HomeView.ReplantHistory)
    {
        <section class="replant-history-screen">

            <div class="subpage-header">

                <button class="back-button" @onclick="OpenMenu">
                    ‹
                </button>

                <h2>REPLANT HISTORY</h2>

            </div>

            <section class="replant-record-card">

                <h3>BEST RECORDS</h3>

                <div class="replant-record-row">
                    <span>最短REPLANT</span>

                    <span>
                        @FormatReplantDuration(
                            game.ShortestReplantSeconds)
                    </span>
                </div>

                <div class="replant-record-row">
                    <span>最大周回生産</span>

                    <span>
                        @NumberFormatter.Format(
                            game.MaxRunProducedPotato)
                        芋
                    </span>
                </div>

                <div class="replant-record-row">
                    <span>最大獲得種芋</span>

                    <span>
                        @game.MaxSeedPotatoPerReplant
                    </span>
                </div>

            </section>

            <section class="replant-history-list">

                @if (game.ReplantHistory.Count == 0)
                {
                    <div class="replant-history-empty">
                        REPLANT履歴はまだありません。
                    </div>
                }
                else
                {
                    @for (int i = 0;
                          i < game.ReplantHistory.Count;
                          i++)
                    {
                        ReplantHistoryEntry entry =
                            game.ReplantHistory[i];

                        int replantNumber =
                            game.ReplantCount - i;

                        <section class="replant-history-card">

                            <div class="replant-history-number">
                                #@replantNumber
                            </div>

                            <div class="replant-history-date">
                                @FormatReplantDate(
                                    entry.ReplantedAtUtc)
                            </div>

