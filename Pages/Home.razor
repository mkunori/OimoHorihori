@page "/"

@using Microsoft.JSInterop
@using OimoHorihori.Constants
@using OimoHorihori.Models
@using OimoHorihori.Services
@using OimoHorihori.Utilities

@inject IJSRuntime JS
@inject SaveService SaveService

@implements IAsyncDisposable

<PageTitle>OIMO HORIHORI</PageTitle>

<main class="game">

    <header class="game-header">

        <h1>OIMO HORIHORI</h1>

    </header>
    @if (currentView == HomeView.Horihori)
    {
        @if (!game.HasStarted)
        {
            <section class="start-screen">

                <button class="dig-button" @onclick="StartGame">
                    掘る！
                </button>

            </section>
        }
        else
        {
            <section class="status-panel">

                <div class="potato-value">
                    @NumberFormatter.Format(
                        game.Potato)
                    <span class="unit">
                        芋
                    </span>
                </div>

                <div class="production-value">
                    +@NumberFormatter.Format(game.ProductionPerSecond)
                    / sec
                </div>

                <div class="total-value">
                    TOTAL
                    @NumberFormatter.Format(
                        game.TotalPotato)
                </div>

            </section>

            <section class="purchase-mode">

                <button class="@GetPurchaseModeClass(PurchaseMode.One)" @onclick="() => SetPurchaseMode(PurchaseMode.One)">
                    +1
                </button>

                <button class="@GetPurchaseModeClass(PurchaseMode.Ten)" @onclick="() => SetPurchaseMode(PurchaseMode.Ten)">
                    +10
                </button>

                <button class="@GetPurchaseModeClass(PurchaseMode.Max)" @onclick="() => SetPurchaseMode(PurchaseMode.Max)">
                    MAX
                </button>

            </section>

            <section class="farm-list">

                @foreach (Farm farm in game.Farms)
                {
                    int purchaseLevels =
                        GetAffordablePurchaseLevels(
                            farm);

                    bool canBuy =
                        purchaseLevels > 0;

                    double purchaseCost =
                        GetPurchaseDisplayCost(
                            farm);

                    <button class="farm-card" disabled="@(!canBuy)" @onclick="() => BuyFarm(farm)">

                        <div class="farm-header">

                            <span class="farm-name">
                                @farm.Name
                            </span>

                            <span class="farm-level">
                                Lv. @farm.Level
                            </span>

                        </div>

                        <div class="farm-production">
                            +@NumberFormatter.Format(farm.ProductionPerSecond)
                            / sec
                        </div>

                        <div class="farm-purchase-level">
                            @GetPurchaseLevelText(farm)
                        </div>

                        <div class="farm-cost">
                            COST
                            @NumberFormatter.Format(
                                purchaseCost)
                            芋
                        </div>

                    </button>
                }

                <button class="replant-card" @onclick="OpenReplant">

                    <div class="replant-header">

                        <span class="replant-name" disabled="@(!game.CanReplant)">
                            REPLANT
                        </span>

                        <span class="replant-seed">
                            種芋 ×@game.ReplantSeedPotato
                        </span>

                    </div>

                    <div class="replant-production">
                        今回の生産
                        @NumberFormatter.Format(
                            game.RunProducedPotato)
                        芋
                    </div>

                    <div class="replant-next">
                        次の種芋まで
                        @NumberFormatter.Format(
                            game.ProductionUntilNextSeedPotato)
                        芋
                    </div>

                </button>

            </section>

        }

    }
    else if (currentView == HomeView.Menu)
    {
        <section class="menu-screen">

            <h2>MENU</h2>

            <div class="menu-list">

                <button class="menu-item" @onclick="OpenSeedUpgrades">
                    <span>種芋強化</span>
                    <span>›</span>
                </button>

                <button class="menu-item" @onclick="OpenOimoBook">
                    <span>いも図鑑</span>
                    <span>
                        @game.DiscoveredOimoSpeciesCount
                        /20
                    </span>
                </button>

                <button class="menu-item" @onclick="OpenAchievements">
                    <span>実績</span>
                    <span>›</span>
                </button>

                <button class="menu-item" @onclick="OpenStatistics">
                    <span>統計</span>
                    <span>›</span>
                </button>

                <button class="menu-item" @onclick="ShareGameAsync">
                    <span>共有</span>
                    <span>SHARE</span>
                </button>

                <button class="menu-item" @onclick="OpenSettings">
                    <span>設定</span>
                    <span>›</span>
                </button>

            </div>

            @if (!string.IsNullOrEmpty(shareResultMessage))
            {
                <div class="share-result">
                    @shareResultMessage
                </div>
            }

        </section>

        
    }
    else if (currentView == HomeView.SeedUpgrades)
    {
        <section class="upgrade-screen">

            <div class="subpage-header">

                <button class="back-button" @onclick="OpenMenu">
                    ‹
                </button>

                <h2>種芋強化</h2>

            </div>

            <div class="seed-potato-status">
                <div class="seed-potato-label">
                    種芋
                </div>

                <div class="seed-potato-value">
                    @game.SeedPotato
                </div>
            </div>

            <div class="upgrade-list">

                <button class="upgrade-card" disabled="@(game.SeedPotato < game.ProductionUpgradeCost)"
                        @onclick="BuyProductionUpgradeAsync">

                    <div class="upgrade-header">

                        <span class="upgrade-name">
                            生産力強化
                        </span>

                        <span class="upgrade-level">
                            Lv.@game.ProductionUpgradeLevel
                        </span>

                    </div>

                    <div class="upgrade-effect">
                        全生産
                        +@((game.ProductionUpgradeLevel * 0.5).ToString("0.0"))%
                    </div>

                    <div class="upgrade-cost">
                        NEXT
                        @game.ProductionUpgradeCost
                        種芋
                    </div>

                </button>

                <button class="upgrade-card" disabled="@(game.SeedPotato < game.DigUpgradeCost)"
                        @onclick="BuyDigUpgradeAsync">

                    <div class="upgrade-header">

                        <span class="upgrade-name">
                            掘り出し強化
                        </span>

                        <span class="upgrade-level">
                            Lv.@game.DigUpgradeLevel
                        </span>

                    </div>

                    <div class="upgrade-effect">
                        基礎
                        +@((game.DigUpgradeLevel * 0.1).ToString("0.0"))
                        / sec
                    </div>

                    <div class="upgrade-cost">
                        NEXT
                        @game.DigUpgradeCost
                        種芋
                    </div>

                </button>

                <button class="upgrade-card" disabled="@(!CanBuyOfflineUpgrade())" @onclick="BuyOfflineUpgradeAsync">

                    <div class="upgrade-header">

                        <span class="upgrade-name">
                            放置強化
                        </span>

                        <span class="upgrade-level">
                            Lv.@game.OfflineUpgradeLevel
                        </span>

                    </div>

                    <div class="upgrade-effect">
                        最大
                        @FormatOfflineUpgradeHours()
                    </div>

                    <div class="upgrade-cost">

                        @if (game.IsOfflineUpgradeMax)
                        {
                            <span>MAX</span>
                        }
                        else
                        {
                            <span>
                                NEXT
                                @game.OfflineUpgradeCost
                                種芋
                            </span>
                        }

                    </div>

                </button>

            </div>

        </section>
    }
    else if (currentView == HomeView.Statistics)
    {
        <section class="statistics-screen">

            <div class="subpage-header">

                <button class="back-button" @onclick="OpenMenu">
                    ‹
                </button>

                <h2>統計</h2>

            </div>

            <div class="statistics-list">

                <section class="statistics-section">

                    <h3>芋</h3>

                    <div class="stat-row">
                        <span>累計生産</span>
                        <span>
                            @NumberFormatter.Format(
                                game.TotalPotato)
                            芋
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>累計消費</span>
                        <span>
                            @NumberFormatter.Format(
                                game.TotalConsumedPotato)
                            芋
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>歴代最高 芋/sec</span>
                        <span>
                            @NumberFormatter.Format(
                                game.BestProductionPerSecond)
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>最大周回生産</span>
                        <span>
                            @NumberFormatter.Format(
                                game.MaxRunProducedPotato)
                            芋
                        </span>
                    </div>

                </section>

                <section class="statistics-section">

                    <h3>REPLANT</h3>

                    <div class="stat-row">
                        <span>REPLANT回数</span>
                        <span>
                            @game.ReplantCount
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>現在の種芋</span>
                        <span>
                            @game.SeedPotato
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>累計獲得種芋</span>
                        <span>
                            @game.TotalSeedPotatoEarned
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>累計消費種芋</span>
                        <span>
                            @game.TotalSeedPotatoSpent
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>最大一括獲得</span>
                        <span>
                            @game.MaxSeedPotatoPerReplant
                        </span>
                    </div>

                </section>

                <section class="statistics-section">

                    <h3>畑</h3>

                    <div class="farm-stat">

                        <div class="farm-stat-name">
                            畑1
                        </div>

                        <div class="stat-row">
                            <span>累計購入</span>
                            <span>
                                @game.Farm1TotalPurchases Lv
                            </span>
                        </div>

                        <div class="stat-row">
                            <span>最高Lv</span>
                            <span>
                                @game.Farm1BestLevel
                            </span>
                        </div>

                    </div>

                    <div class="farm-stat">

                        <div class="farm-stat-name">
                            畑2
                        </div>

                        <div class="stat-row">
                            <span>累計購入</span>
                            <span>
                                @game.Farm2TotalPurchases Lv
                            </span>
                        </div>

                        <div class="stat-row">
                            <span>最高Lv</span>
                            <span>
                                @game.Farm2BestLevel
                            </span>
                        </div>

                    </div>

                    <div class="farm-stat">

                        <div class="farm-stat-name">
                            畑3
                        </div>

                        <div class="stat-row">
                            <span>累計購入</span>
                            <span>
                                @game.Farm3TotalPurchases Lv
                            </span>
                        </div>

                        <div class="stat-row">
                            <span>最高Lv</span>
                            <span>
                                @game.Farm3BestLevel
                            </span>
                        </div>

                    </div>

                </section>

                <section class="statistics-section">

                    <h3>OFFLINE</h3>

                    <div class="stat-row">
                        <span>累計オフライン生産</span>
                        <span>
                            @NumberFormatter.Format(
                                game.TotalOfflineProducedPotato)
                            芋
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>最大オフライン獲得</span>
                        <span>
                            @NumberFormatter.Format(
                                game.MaxOfflineProducedPotato)
                            芋
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>現在の放置上限</span>
                        <span>
                            @FormatOfflineUpgradeHours()
                        </span>
                    </div>

                </section>

                <section class="statistics-section">

                    <h3>PLAY</h3>

                    <div class="stat-row">
                        <span>プレイ時間</span>
                        <span>
                            @FormatPlayTime(
                                game.TotalPlayTimeSeconds)
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>掘る！回数</span>
                        <span>
                            @game.DigButtonCount
                        </span>
                    </div>

                    <div class="stat-row">
                        <span>開始日時</span>
                        <span>
                            @FormatGameStartedAt()
                        </span>
                    </div>

                </section>

            </div>

        </section>
    }
    else if (
    currentView
        == HomeView.Achievements)
    {
        <section class="achievements-screen">

            <div class="subpage-header">

                <button class="back-button" @onclick="OpenMenu">
                    ‹
                </button>

                <h2>実績</h2>

            </div>

            <div class="achievement-progress">

                @GetUnlockedAchievementCount()
                /
                @AchievementCatalog.All.Count

            </div>

            <div class="achievement-list">

                @foreach (
                    AchievementDefinition achievement
                    in AchievementCatalog.All)
                {
                    bool unlocked =
                        game.IsAchievementUnlocked(
                            achievement.Id);

                    <div class="@GetAchievementClass(unlocked)">

                        <div class="achievement-header">

                            <span class="achievement-name">
                                @achievement.Name
                            </span>

                            @if (unlocked)
                            {
                                <span class="achievement-status">
                                    CLEAR
                                </span>
                            }

                        </div>

                        <div class="achievement-description">
                            @achievement.Description
                        </div>

                        @if (unlocked)
                        {
                            <div class="achievement-date">
                                @FormatAchievementDate(
                                    achievement.Id)
                            </div>
                        }

                    </div>
                }

            </div>

        </section>
    }
    else if (
    currentView
        == HomeView.OimoBook)
    {
        <section class="oimo-book-screen">

            <div class="subpage-header">

                <button class="back-button" @onclick="OpenMenu">
                    ‹
                </button>

                <h2>いも図鑑</h2>

            </div>

            <div class="oimo-book-progress">

                @game.DiscoveredOimoSpeciesCount
                / 20

            </div>

            <div class="oimo-book-list">

                @foreach (
                    OimoSpeciesDefinition species
                    in OimoSpeciesCatalog.All)
                {
                    bool discovered =
                        game.IsOimoDiscovered(
                            species.Id);

                    <div class="@GetOimoBookCardClass(discovered)">

                        <div class="oimo-book-number">
                            #@GetOimoSpeciesNumber(species)
                        </div>

                        <div class="oimo-book-name">

                            @if (discovered)
                            {
                                @species.Name
                            }
                            else
                            {
                                <span>??????</span>
                            }

                        </div>

                        @if (discovered)
                        {
                            <div class="oimo-book-count">
                                ×@game.GetOimoDiscoveryCount(species.Id)
                            </div>
                        }

                    </div>
                }

            </div>

        </section>
    }
    else if (
    currentView
        == HomeView.Settings)
    {
        <section class="settings-screen">

            <div class="subpage-header">

                <button class="back-button" @onclick="OpenMenu">
                    ‹
                </button>

                <h2>設定</h2>

            </div>

            <div class="settings-list">

                <section class="settings-card">

                    <div class="settings-row">

                        <span>
                            OFFLINE LIMIT
                        </span>

                        <span>
                            @FormatOfflineLimit()
                        </span>

                    </div>

                </section>

                <section class="settings-card">

                    <div class="settings-row">

                        <span>
                            VERSION
                        </span>

                        <span>
                            @BuildInfo.Version
                        </span>

                    </div>

                </section>

                <section class="settings-card">

                    <div class="settings-card-title">
                        DATA
                    </div>

                    <button class="reset-button" @onclick="OpenResetConfirmation">
                        セーブデータ初期化
                    </button>

                </section>

            </div>

        </section>
    }

    <nav class="bottom-nav">

        <button class="@GetBottomNavClass(true)" @onclick="OpenHorihori">
            HORIHORI
        </button>

        <button class="@GetBottomNavClass(false)" @onclick="OpenMenu">
            MENU
        </button>

    </nav>

</main>

@if (currentAchievementNotification
    is not null)
{
    <div class="modal-backdrop">

        <div class="achievement-unlock-modal">

            <div class="achievement-unlock-label">
                ACHIEVEMENT UNLOCKED
            </div>

            <h2>
                @currentAchievementNotification.Name
            </h2>

            <div class="achievement-unlock-description">
                @currentAchievementNotification.Description
            </div>

            <button @onclick="CloseAchievementNotification">
                OK
            </button>

        </div>

    </div>
}

@if (BuildInfo.IsDebug && game.HasStarted)
{
    <section class="debug-panel">

        <div class="debug-title">
            DEBUG
        </div>

        <button @onclick="() => DebugAddPotatoAsync(1_000)">
            +1.000e+3 芋
        </button>

        <button @onclick="() => DebugAddPotatoAsync(1_000_000)">
            +1.000e+6 芋
        </button>

        <button @onclick="() => DebugOfflineAsync(3_600)">
            OFFLINE 1時間
        </button>

        <button @onclick="() => DebugOfflineAsync(43_200)">
            OFFLINE 12時間
        </button>

        <button @onclick="DebugAddSeedPotatoAsync">
            +100 種芋
        </button>

        <button @onclick="DebugBuyProductionUpgradeAsync">
            生産力強化
        </button>

        <button @onclick="DebugBuyDigUpgradeAsync">
            掘り出し強化
        </button>

        <button @onclick="DebugBuyOfflineUpgradeAsync">
            放置強化
        </button>

    </section>
}

@if (showOfflineResult)
{
    <div class="modal-backdrop">

        <div class="offline-modal">

            <h2>おかえり！</h2>

            @if (offlineReward > 0)
            {
                <div class="offline-label">
                    OFFLINE
                </div>

                <div class="offline-time">
                    @FormatOfflineTime(
                        offlineDuration)
                </div>

                <div class="offline-reward">
                    +@NumberFormatter.Format(offlineReward)
                    芋
                </div>
            }

            @if (offlineOimoDiscoveries.Count > 0)
            {
                <div class="offline-oimo">

                    <div class="offline-oimo-label">
                        いも図鑑
                    </div>

                    @foreach (
                        OimoSpeciesDefinition species
                        in offlineOimoDiscoveries)
                    {
                        <div class="offline-oimo-entry">
                            @species.Name
                        </div>
                    }

                </div>
            }

            <button @onclick="CloseOfflineResult">
                OK
            </button>

        </div>

    </div>
}

@if (showResetConfirmation)
{
    <div class="modal-backdrop">

        <div class="confirm-modal">

            <h2>
                セーブデータ初期化
            </h2>

            <p>
                本当にセーブデータを初期化しますか？
            </p>

            <div class="confirm-actions">

                <button @onclick="CancelReset">
                    キャンセル
                </button>

                <button class="danger-button" @onclick="ResetGameAsync">
                    初期化する
                </button>

            </div>

        </div>

    </div>
}

@if (showReplant)
{
    <div class="modal-backdrop">

        <div class="replant-modal">

            <h2>
                REPLANT
            </h2>

            <div class="replant-detail">

                <div class="replant-detail-label">
                    今回の生産
                </div>

                <div class="replant-detail-value">
                    @NumberFormatter.Format(
                        game.RunProducedPotato)
                    芋
                </div>

            </div>

            <div class="replant-detail">

                <div class="replant-detail-label">
                    獲得予定
                </div>

                <div class="replant-detail-value">
                    種芋 ×@game.ReplantSeedPotato
                </div>

            </div>

            <div class="replant-detail">

                <div class="replant-detail-label">
                    次の種芋まで
                </div>

                <div class="replant-detail-value">
                    @NumberFormatter.Format(
                        game.ProductionUntilNextSeedPotato)
                    芋
                </div>

            </div>

            <div class="replant-actions">

                <button @onclick="CloseReplant">
                    閉じる
                </button>

                <button disabled="@(!game.CanReplant)" @onclick="OpenReplantConfirmation">
                    REPLANT
                </button>

            </div>

        </div>

    </div>
}

@if (showReplantConfirmation)
{
    <div class="modal-backdrop">

        <div class="confirm-modal">

            <h2>
                REPLANT
            </h2>

            <p>
                本当に REPLANT しますか？
            </p>

            <p>
                現在の芋、畑Lv、周回生産量はリセットされます。
            </p>

            <div class="confirm-actions">

                <button @onclick="CancelReplant">
                    キャンセル
                </button>

                <button @onclick="ExecuteReplantAsync">
                    REPLANT
                </button>

            </div>

        </div>

    </div>
}

@if (
    showOimoDiscovery
    && lastDiscoveredOimo
        is not null)
{
    <div class="modal-backdrop">

        <div class="oimo-discovery-modal">

            <div class="oimo-discovery-label">
                NEW OIMO
            </div>

            <h2>
                @lastDiscoveredOimo.Name
            </h2>

            <div class="oimo-discovery-count">
                ×@game.GetOimoDiscoveryCount(lastDiscoveredOimo.Id)
            </div>

            <button @onclick="CloseOimoDiscovery">
                OK
            </button>

        </div>

    </div>
}

@if (newerSaveVersion is not null)
{
    <div class="modal-backdrop">

        <div class="confirm-modal">

            <h2>
                セーブデータを保護しました
            </h2>

            <p>
                このセーブデータは
                Version
                @newerSaveVersion
                用です。
            </p>

            <p>
                現在のアプリ
                Version
                @GameConstants.SaveVersion
                では読み込めません。
            </p>

            <p>
                データ保護のため、
                セーブ内容には変更を加えていません。
            </p>

        </div>

    </div>
}

@code {
    private GameState game = new();
    private PeriodicTimer? timer;
    private CancellationTokenSource cancellationTokenSource = new();
    private DateTimeOffset lastUpdateTime;
    private DateTimeOffset lastAutoSaveTime;
    private bool showOfflineResult;
    private TimeSpan offlineDuration;
    private double offlineReward;
    private bool showResetConfirmation;
    private PurchaseMode purchaseMode = PurchaseMode.One;
    private bool showReplant;
    private bool showReplantConfirmation;
    private OimoSpeciesDefinition? lastDiscoveredOimo;
    private bool showOimoDiscovery;
    private List<OimoSpeciesDefinition> offlineOimoDiscoveries = new();
    private string? shareResultMessage;
    private Queue<AchievementDefinition> achievementNotificationQueue = new();
    private AchievementDefinition? currentAchievementNotification;
    private bool isPageHidden;
    private DateTimeOffset? pageHiddenAtUtc;
    private DotNetObjectReference<Home>? visibilityReference;
    private int? newerSaveVersion;

    private void SetPurchaseMode(PurchaseMode mode)
    {
        purchaseMode = mode;
    }

    protected override async Task OnInitializedAsync()
    {
        SaveData? save = await SaveService.LoadAsync();
        DateTimeOffset now = DateTimeOffset.UtcNow;

        if (save is not null)
        {
            int loadedVersion = save.Version;

            // 現在のアプリより
            // 新しいセーブは絶対に触らない
            if (loadedVersion > GameConstants.SaveVersion)
            {
                newerSaveVersion = loadedVersion;

                return;
            }

            bool loaded = game.TryLoadSaveData(save);
            if (!loaded)
            {
                await SaveService.DeleteAsync();
            }
            else
            {
                // v1を読み込んだ場合は、
                // GameState上ですでにv2へ移行済みなので
                // v2形式で保存し直す
                if (loadedVersion < GameConstants.SaveVersion)
                {
                    await SaveGameAsync();
                }

                double elapsedSeconds = (now - save.LastSaveTimeUtc).TotalSeconds;
                if (elapsedSeconds > 0)
                {
                    if (game.HasStarted)
                    {
                        double cappedSeconds = Math.Min(elapsedSeconds, game.OfflineLimitSeconds);

                        offlineReward = game.ProduceOffline(elapsedSeconds);
                        offlineDuration = TimeSpan.FromSeconds(cappedSeconds);
                    }

                    if (game.GameStartedAtUtc != default)
                    {
                        IReadOnlyList<OimoSpeciesDefinition> discoveries = game.ProduceOfflineOimoDiscoveries(elapsedSeconds);

                        offlineOimoDiscoveries = discoveries.ToList();
                    }

                    if (game.HasStarted || offlineOimoDiscoveries.Count > 0)
                    {
                        showOfflineResult = true;
                    }

                    await SaveGameAsync();
                }
            }
        }

        lastUpdateTime = now;
        lastAutoSaveTime = now;

        visibilityReference = DotNetObjectReference.Create(this);

        await JS.InvokeVoidAsync("oimoVisibility.register", visibilityReference);

        timer = new PeriodicTimer(TimeSpan.FromMilliseconds(GameConstants.GameLoopIntervalMilliseconds));
        _ = RunGameLoopAsync();
        IReadOnlyList<AchievementDefinition> unlockedAchievements = game.CheckAchievements();

        foreach (AchievementDefinition achievement in unlockedAchievements)
        {
            achievementNotificationQueue.Enqueue(achievement);
        }

        if (unlockedAchievements.Count > 0)
        {
            ShowNextAchievementNotification();

            await SaveGameAsync();
        }
    }

    private async Task StartGame()
    {
        DateTimeOffset now = DateTimeOffset.UtcNow;
        game.HasStarted = true;

        if (game.GameStartedAtUtc == default)
        {
            game.GameStartedAtUtc = now;
        }

        game.RunStartedAtUtc = now;
        game.DigButtonCount++;
        game.ProducePotato(0.1);
        CheckAchievements();
        lastUpdateTime = now;

        await SaveGameAsync();
    }

    private async Task BuyFarm(Farm farm)
    {
        int maxLevels = GetPurchaseMaxLevels();
        int purchasedLevels = game.BuyFarm(farm, maxLevels);

        if (purchasedLevels <= 0)
        {
            return;
        }

        if (purchaseMode == PurchaseMode.Ten)
        {
            game.HasUsedTenPurchaseMode = true;
        }

        if (purchaseMode == PurchaseMode.Max)
        {
            game.HasUsedMaxPurchaseMode = true;
        }

        CheckAchievements();

        await SaveGameAsync();
    }

    private async Task RunGameLoopAsync()
    {
        if (timer is null)
        {
            return;
        }

        try
        {
            while (await timer.WaitForNextTickAsync(cancellationTokenSource.Token))
            {
                DateTimeOffset now = DateTimeOffset.UtcNow;
                double elapsedSeconds = (now - lastUpdateTime).TotalSeconds;

                lastUpdateTime = now;

                if (isPageHidden)
                {
                    continue;
                }

                if (game.GameStartedAtUtc != default && double.IsFinite(elapsedSeconds) && elapsedSeconds > 0)
                {
                    game.TotalPlayTimeSeconds += elapsedSeconds;
                }

                if (game.GameStartedAtUtc
                    != default)
                {
                    IReadOnlyList<OimoSpeciesDefinition> discoveries = game.AdvanceOimoDiscovery(elapsedSeconds);

                    if (discoveries.Count > 0)
                    {
                        lastDiscoveredOimo = discoveries[^1];
                        showOimoDiscovery = true;
                        CheckAchievements();

                        await SaveGameAsync();
                    }
                }

                if (game.HasStarted)
                {
                    game.ProduceForSeconds(elapsedSeconds);
                    game.BestProductionPerSecond = Math.Max(game.BestProductionPerSecond, game.ProductionPerSecond);
                    CheckAchievements();
                }

                if (game.GameStartedAtUtc != default && (now - lastAutoSaveTime).TotalSeconds >= GameConstants.AutoSaveIntervalSeconds)
                {
                    await SaveGameAsync();
                    lastAutoSaveTime = now;
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        cancellationTokenSource.Cancel();

        timer?.Dispose();

        if (visibilityReference is not null)
        {
            try
            {
                await JS.InvokeVoidAsync("oimoVisibility.unregister");
            }
            catch
            {
                // ページ終了中などは無視
            }

            visibilityReference.Dispose();
        }

        cancellationTokenSource.Dispose();
    }

